# OpenAI API Key (Required for GPT-4 based evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Alternative LLM)
GOOGLE_API_KEY=your_gemini_api_key_here

# Choose LLM Provider: "openai" or "gemini"
LLM_PROVIDER=gemini

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Voice Settings
VOICE_ENABLED=true
TTS_PROVIDER=gtts

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
