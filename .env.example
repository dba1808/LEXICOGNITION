# ===========================================
# ORION - AI Viva Voce System Configuration
# ===========================================
# Copy this file to .env and add your API keys

# OpenAI API Key (Optional - for GPT-4 evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (REQUIRED for gemini-3-flash-preview)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Choose LLM Provider: "openai" or "gemini"
LLM_PROVIDER=gemini

# Embedding Model (default works well)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Voice Settings
VOICE_ENABLED=true
TTS_PROVIDER=gtts

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
